{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Glossary: Set up dependencies",
      "detail": "Run once after cloning, or after pyproject.toml changes. Requires uv (https://docs.astral.sh/uv/) and internet access; uv installs Python 3.12+ if needed.",
      "type": "process",
      "command": "uv",
      "args": [
        "sync"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "process",
      "command": "uv",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Glossary: Convert all formats",
      "args": [
        "run",
        "scripts/build.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "process",
      "command": "uv",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Glossary: Validate exports",
      "args": [
        "run",
        "scripts/build.py",
        "--check"
      ],
      "group": "test"
    }
  ]
}
