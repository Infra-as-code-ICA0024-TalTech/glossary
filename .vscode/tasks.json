{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Glossary: Create Python environment",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "venv",
        ".venv"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "-m",
          "venv",
          ".venv"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Glossary: Set up dependencies",
      "detail": "Run once after cloning, or after requirements.txt changes. Requires Python 3.12+ and internet access.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Glossary: Create Python environment",
      "problemMatcher": []
    },
    {
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Glossary: Convert all formats",
      "args": [
        "scripts/build.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Glossary: Validate exports",
      "args": [
        "scripts/build.py",
        "--check"
      ],
      "group": "test"
    }
  ]
}
